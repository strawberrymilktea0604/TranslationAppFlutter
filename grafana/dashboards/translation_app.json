{
  "id": null,
  "uid": "translationapp",
  "title": "TranslationApp Monitoring",
  "tags": ["translation", "backend", "postgres"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Request Rate (1m)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(translation_app_http_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(translation_app_http_requests_total{http_status=~\"5..\"}[5m])) / sum(rate(translation_app_http_requests_total[5m])) * 100",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" }
    },
    {
      "type": "graph",
      "title": "95th Percentile Request Latency",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(translation_app_http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "lines": true
    },
    {
      "type": "graph",
      "title": "Postgres Exporter Up",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "up{job=\"postgres_exporter\"}",
          "refId": "A"
        }
      ],
      "lines": true
    }
  ]
}
