# Multi-stage build for test image with AI library installation
FROM python:3.10-slim as builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install build dependencies for AI libraries and testing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python packages in builder stage
COPY requirements.txt requirements-dev.txt ./
RUN python -m pip install --upgrade pip \
    && pip install --no-cache-dir --user -r requirements-dev.txt

# Test stage
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/root/.local/bin:$PATH" \
    OMP_NUM_THREADS=1 \
    KMP_DUPLICATE_LIB_OK=True \
    MKL_NUM_THREADS=1 \
    PYTEST_TIMEOUT=300

WORKDIR /app

# Install runtime system dependencies for OCR, image processing, OpenCV, and testing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tesseract-ocr \
    libtesseract-dev \
    libleptonica-dev \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    libgl1 \
    libgthread-2.0-0 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# Set Tesseract language data path
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr-4.1/tessdata

# Copy installed packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code and tests
COPY alembic.ini ./
COPY ./app ./app
COPY ./alembic ./alembic
COPY ./tests ./tests

# Create coverage directory
RUN mkdir -p /app/coverage

# Default command runs pytest
CMD ["pytest", "tests/", "-v", "--cov=app", "--cov-report=html:/app/coverage", "--cov-report=term-missing"]
