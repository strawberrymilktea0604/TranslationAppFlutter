# Application
PROJECT_NAME="TranslationApp API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development, staging, production

# ==========================================
# DATABASE SETTINGS (Chọn 1 trong 3 URL bên dưới)
# ==========================================
# 1. Nếu chạy toàn bộ bằng Docker (All-in-Docker):
# DATABASE_URL="postgresql+asyncpg://postgres:password@db:5432/translation_app"

# 2. Nếu chạy Backend trên PC + Database trong Docker:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5433/translation_app"

# 3. Nếu chạy Backend trên PC + Database cài trực tiếp trên PC (Native):
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/translation_app"

# ==========================================
# REDIS SETTINGS (Chọn 1 trong 2 URL bên dưới)
# ==========================================
# 1. Nếu chạy toàn bộ bằng Docker:
# REDIS_URL="redis://redis:6379/0"

# 2. Nếu chạy Backend trên PC (Redis vẫn trong Docker):
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# SECURITY & API KEYS
# ==========================================
# Security - JWT
SECRET_KEY="your-secret-key-here-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Services
TRANSLATION_SERVICE_TIMEOUT=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
TRANSLATION_FALLBACK_ENABLED=true

# Rate limiting
GUEST_MAX_REQUESTS_PER_HOUR=10
GUEST_MAX_CHAR_LENGTH=500
USER_MAX_REQUESTS_PER_HOUR=100
USER_MAX_CHAR_LENGTH=5000
RATE_LIMIT_WINDOW_SECONDS=3600

# CORS
BACKEND_CORS_ORIGINS="*"

# ==========================================
# GOOGLE TRANSLATION API (Primary provider for /translate/text)
# ==========================================
# Get your API Key from: https://console.cloud.google.com/apis/credentials
# Enable "Cloud Translation API" in your GCP project first.
# Pricing: https://cloud.google.com/translate/pricing (free tier: 500K chars/month)
# If key is missing/unavailable and TRANSLATION_FALLBACK_ENABLED=true,
# backend will automatically use googletrans as fallback provider.
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key-here"

HF_TOKEN="hf_chuỗi_token_cua_ban_lay_tren_huggingface"