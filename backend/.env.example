# Application
PROJECT_NAME="TranslationApp API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development, staging, production

# ==========================================
# DATABASE SETTINGS (Chọn 1 trong 3 URL bên dưới)
# ==========================================
# 1. Nếu chạy toàn bộ bằng Docker (All-in-Docker):
# DATABASE_URL="postgresql+asyncpg://postgres:password@db:5432/translation_app"

# 2. Nếu chạy Backend trên PC + Database trong Docker:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5433/translation_app"

# 3. Nếu chạy Backend trên PC + Database cài trực tiếp trên PC (Native):
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/translation_app"

# ==========================================
# REDIS SETTINGS (Chọn 1 trong 2 URL bên dưới)
# ==========================================
# 1. Nếu chạy toàn bộ bằng Docker:
# REDIS_URL="redis://redis:6379/0"

# 2. Nếu chạy Backend trên PC (Redis vẫn trong Docker):
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# SECURITY & API KEYS
# ==========================================
# Security - JWT
SECRET_KEY="your-secret-key-here-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin Account (created on startup)
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin123"

# AI Services
TRANSLATION_SERVICE_TIMEOUT=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
TRANSLATION_FALLBACK_ENABLED=true

# ==========================================
# RATE LIMITING & QUOTA
# ==========================================
# Base request limits per hour (for text translation)
GUEST_MAX_REQUESTS_PER_HOUR=10
USER_MAX_REQUESTS_PER_HOUR=100
ADMIN_MAX_REQUESTS_PER_HOUR=1000
PREMIUM_MAX_REQUESTS_PER_HOUR=500

# Character limits per request
GUEST_MAX_CHAR_LENGTH=500
USER_MAX_CHAR_LENGTH=5000
ADMIN_MAX_CHAR_LENGTH=50000

# Rate limit window
RATE_LIMIT_WINDOW_SECONDS=3600  # 1 hour

# Fallback provider (Google Translate) rate limiting
# Prevents IP ban by limiting requests to fallback service
FALLBACK_MAX_REQUESTS_PER_MINUTE=20

# CORS
BACKEND_CORS_ORIGINS="*"

# ==========================================
# GOOGLE TRANSLATION API (Primary provider for /translate/text)
# ==========================================
# Get your API Key from: https://console.cloud.google.com/apis/credentials
# Enable "Cloud Translation API" in your GCP project first.
# Pricing: https://cloud.google.com/translate/pricing (free tier: 500K chars/month)
# If key is missing/unavailable and TRANSLATION_FALLBACK_ENABLED=true,
# backend will automatically use googletrans as fallback provider.
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key-here"

HF_TOKEN="hf_chuỗi_token_cua_ban_lay_tren_huggingface"
# ==========================================
# WEBSOCKET CONFIGURATION
# ==========================================
# Connection settings
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30  # seconds
WEBSOCKET_PING_TIMEOUT=10   # seconds
WEBSOCKET_CONNECTION_TIMEOUT=30  # seconds

# Buffer sizes
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_MESSAGE_QUEUE_SIZE=100
WEBSOCKET_BUFFER_SIZE=1024  # KB

# Conversation-specific (real-time voice translation)
CONVERSATION_SESSION_TIMEOUT=300  # seconds
CONVERSATION_SEGMENT_TIMEOUT=10   # seconds - end utterance if no audio
CONVERSATION_MAX_AUDIO_SIZE=50  # MB
CONVERSATION_MAX_SESSIONS_PER_USER=3

# Audio streaming
AUDIO_CHUNK_SIZE=4096  # bytes per chunk
AUDIO_SAMPLE_RATE=16000  # Hz
AUDIO_CHANNELS=1  # mono
AUDIO_FORMAT="pcm_s16le"

# WebSocket pool
WEBSOCKET_POOL_SIZE=100

# Rate limiting for WebSocket
WEBSOCKET_MESSAGE_RATE_LIMIT=1000  # messages per minute
WEBSOCKET_AUDIO_RATE_LIMIT_MB=50   # MB per minute

# Logging
WEBSOCKET_LOG_LEVEL=INFO

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
# Log Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log Format
LOG_FORMAT=json  # json or standard

# FluentD Configuration
FLUENTD_ENABLED=true
FLUENTD_HOST=log_aggregator
FLUENTD_PORT=24224
FLUENTD_BUFFER_LIMIT=256m
FLUENTD_FLUSH_INTERVAL=10s

# Real-time Session Logging
REALTIME_SESSION_LOGGING_ENABLED=true
REALTIME_SESSION_VERBOSE=false

# Session Event Retention
SESSION_LOG_RETENTION_DAYS=30
SESSION_LOG_COMPRESSION=true

# Performance Monitoring
PERFORMANCE_METRICS_ENABLED=true
METRICS_FLUSH_INTERVAL=60

# Audit Logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_ADMIN_ACTIONS=true
AUDIT_LOG_USER_LOGIN=true

# Alert Thresholds
ERROR_RATE_ALERT_THRESHOLD=0.1  # Alert if > 10%
LATENCY_ALERT_THRESHOLD_MS=5000  # Alert if > 5 seconds