# Application
PROJECT_NAME="TranslationApp API"
API_V1_STR="/api/v1"
ENVIRONMENT="staging"

# DATABASE SETTINGS
DATABASE_URL="postgresql+asyncpg://postgres:password@db:5432/translation_app"

# REDIS SETTINGS
REDIS_URL="redis://redis:6379/0"

# SECURITY & API KEYS
SECRET_KEY="your-secret-key-here-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Services
TRANSLATION_SERVICE_TIMEOUT=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# CORS
BACKEND_CORS_ORIGINS="*"

# External APIs (nếu cần)
GOOGLE_CLOUD_API_KEY="optional-api-key"
