# Production environment example for TranslationApp backend

# Application
PROJECT_NAME="TranslationApp API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Database - Neon PostgreSQL
# For SQLAlchemy asyncpg, use ssl=require. sslmode=require may be passed as an
# unsupported asyncpg keyword argument by this stack.
DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@NEON_HOST/DB_NAME?ssl=require"

# Redis - Upstash
REDIS_URL="rediss://default:PASSWORD@UPSTASH_HOST:6379"

# Security - JWT
SECRET_KEY="replace-with-a-secure-random-secret-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin account created on startup
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-a-secure-admin-password"

# AI services
TRANSLATION_SERVICE_TIMEOUT=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
TRANSLATION_FALLBACK_ENABLED=true

# Rate limiting
GUEST_MAX_REQUESTS_PER_HOUR=10
GUEST_MAX_CHAR_LENGTH=500
USER_MAX_REQUESTS_PER_HOUR=100
USER_MAX_CHAR_LENGTH=5000
RATE_LIMIT_WINDOW_SECONDS=3600
FALLBACK_MAX_REQUESTS_PER_MINUTE=20

# CORS
# Comma-separated origins, for example:
# BACKEND_CORS_ORIGINS="https://your-vercel-app.vercel.app,https://your-codespace-name-8000.app.github.dev"
BACKEND_CORS_ORIGINS="https://your-vercel-app.vercel.app"

# Google Translation API
GOOGLE_CLOUD_API_KEY=""

# HuggingFace
HF_TOKEN=""
HF_HUB_DISABLE_XET=1
STT_PRELOAD_TIMEOUT_SECONDS=900

# Monitoring services
# postgres_exporter needs a plain PostgreSQL DSN, not the SQLAlchemy asyncpg URL.
DATA_SOURCE_NAME="postgresql://USER:PASSWORD@NEON_HOST/DB_NAME?sslmode=require"
GF_SECURITY_ADMIN_PASSWORD="replace-with-a-secure-grafana-admin-password"

# Performance monitoring
PERFORMANCE_METRICS_ENABLED=true
METRICS_FLUSH_INTERVAL=60

# Alerting thresholds
ERROR_RATE_ALERT_THRESHOLD=0.1
LATENCY_ALERT_THRESHOLD_MS=5000
