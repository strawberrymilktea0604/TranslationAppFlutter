# Production environment example for TranslationApp backend
PROJECT_NAME="TranslationApp API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# PostgreSQL connection (use production DB host)
DATABASE_URL="postgresql+asyncpg://postgres:password@db:5432/translation_app"

# Redis connection
REDIS_URL="redis://redis:6379/0"

# Security
SECRET_KEY="replace-with-a-secure-32-char-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin account created on startup
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin123"

# CORS
BACKEND_CORS_ORIGINS="https://your-production-domain.com"

# Performance monitoring
PERFORMANCE_METRICS_ENABLED=true
METRICS_FLUSH_INTERVAL=60

# Alerting thresholds
ERROR_RATE_ALERT_THRESHOLD=0.1
LATENCY_ALERT_THRESHOLD_MS=5000

# Optional: configure Google Cloud Translation API if available
GOOGLE_CLOUD_API_KEY=""
