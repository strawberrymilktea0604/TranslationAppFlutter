# ============================================
# WEB ADMIN DEPLOYMENT ENVIRONMENT (.env.web)
# ============================================
# Copy this file to .env and customize for your deployment
# Use for production/staging web admin dashboard deployment

# Application
PROJECT_NAME="TranslationApp API - Web Admin"
API_V1_STR="/api/v1"
ENVIRONMENT="production"  # production, staging, development

# ==========================================
# DATABASE SETTINGS
# ==========================================
# For production with web admin, use managed database service
# Example: DATABASE_URL="postgresql+asyncpg://user:pass@db.example.com:5432/translation_app"
DATABASE_URL="postgresql+asyncpg://postgres:password@db:5432/translation_app"

# ==========================================
# REDIS SETTINGS
# ==========================================
# For production, use managed Redis service
REDIS_URL="redis://redis:6379/0"

# ==========================================
# SECURITY & API KEYS
# ==========================================
# IMPORTANT: Change these for production!
SECRET_KEY="your-production-secret-key-min-32-chars-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Services
TRANSLATION_SERVICE_TIMEOUT=15
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
TRANSLATION_FALLBACK_ENABLED=true

# Rate limiting for Web Admin API
# Admin dashboard has higher limits
ADMIN_MAX_REQUESTS_PER_HOUR=1000
ADMIN_MAX_CHAR_LENGTH=50000
GUEST_MAX_REQUESTS_PER_HOUR=5
GUEST_MAX_CHAR_LENGTH=100
USER_MAX_REQUESTS_PER_HOUR=100
USER_MAX_CHAR_LENGTH=5000
RATE_LIMIT_WINDOW_SECONDS=3600

# ==========================================
# CORS Configuration for Web Admin
# ==========================================
# Specify your production domain(s)
BACKEND_CORS_ORIGINS="http://localhost:8080,https://admin.yourdomain.com"
BACKEND_CORS_ALLOW_CREDENTIALS=true
BACKEND_CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
BACKEND_CORS_ALLOW_HEADERS="Content-Type,Authorization"

# ==========================================
# WEB ADMIN SPECIFIC SETTINGS
# ==========================================
# Admin Dashboard Configuration
ADMIN_DASHBOARD_ENABLED=true
ADMIN_DASHBOARD_URL="http://localhost:8080/admin"
ADMIN_API_TIMEOUT=30

# Admin Authentication
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15
ADMIN_SESSION_TIMEOUT_MINUTES=60
ADMIN_REQUIRE_2FA=false  # Enable 2FA for admins in future

# Dashboard Features
ADMIN_FEATURES_ENABLED="users,translations,analytics,settings,logs,audit"

# ==========================================
# GOOGLE TRANSLATION API (Primary)
# ==========================================
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key-here"

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json or standard
FLUENTD_HOST="log_aggregator"
FLUENTD_PORT="24224"

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_ENABLED=true
BACKUP_DIR="/backups/database"
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
MAX_BACKUPS=7

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json or standard
FLUENTD_ENABLED=true
FLUENTD_HOST="log_aggregator"
FLUENTD_PORT="24224"

# Real-time Session Logging
REALTIME_SESSION_LOGGING_ENABLED=true
REALTIME_SESSION_VERBOSE=false
SESSION_LOG_RETENTION_DAYS=90
PERFORMANCE_METRICS_ENABLED=true
AUDIT_LOGGING_ENABLED=true

# ==========================================
# MONITORING & HEALTH CHECK
# ==========================================
HEALTH_CHECK_INTERVAL=30  # seconds
METRICS_ENABLED=true
METRICS_PORT="9090"
